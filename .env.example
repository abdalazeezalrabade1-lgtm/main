# ——— انسخ هذا الملف إلى .env واملأ القيم. لا ترفع .env إلى Git.

# مفتاح Claude API (مطلوب للمحادثة): https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=

# كلمة مرور الدخول للواجهة (مطلوبة). الأفضل استخدام التجزئة بدل النص الصريح:
#   npm run hash-password -- "كلمة-مرور-قوية"   ثم ضع الناتج في APP_PASSWORD_HASH واحذف APP_PASSWORD
APP_PASSWORD=
# APP_PASSWORD_HASH=

# الشبكة: 127.0.0.1 = على جهازك فقط. للإتاحة عبر الإنترنت: 0.0.0.0 خلف HTTPS مع SECURE_COOKIES=true
HOST=127.0.0.1
PORT=3000
SECURE_COOKIES=false
SESSION_TTL_HOURS=72
# خلف بروكسي (Caddy/Nginx): loopback افتراضيًا؛ docker-compose يضبطها تلقائيًا
TRUST_PROXY=loopback
# العنوان العام للتطبيق (يُستخدم في روابط الإشعارات)، و DOMAIN لـ docker-compose + Caddy
# PUBLIC_URL=https://agent.example.com
# DOMAIN=agent.example.com

# النموذج والجهد
CLAUDE_MODEL=claude-opus-5
CLAUDE_EFFORT=high
CLAUDE_MAX_TOKENS=16000
# إعادة المحاولة تلقائيًا على نموذج بديل عند رفض الطلب (مفعّل افتراضيًا مع claude-opus-5)
CLAUDE_SERVER_FALLBACKS=true

# البحث عبر الإنترنت (أداة Anthropic web search). فعّلها أولًا لمؤسستك في Claude Console.
# التكلفة: 10$ لكل 1000 عملية بحث + التوكنات.
WEB_SEARCH_ENABLED=false
WEB_SEARCH_MAX_USES=5

# ضغط سياق المحادثات الطويلة على خادم Anthropic (beta). معطّل افتراضيًا؛
# بدونه يُنبّهك الوكيل عندما تطول المحادثة كثيرًا لتبدأ محادثة جديدة.
CLAUDE_COMPACTION=false

# الحدود الافتراضية (يمكن تعديلها من صفحة الإعدادات)
MAX_STEPS_PER_RUN=12
MAX_COST_PER_RUN_USD=0.5
DAILY_COST_LIMIT_USD=5

# الملفات والجدولة
MAX_UPLOAD_MB=15
SCHEDULER_ENABLED=true
TZ_NAME=Asia/Riyadh
DATA_DIR=data

# ——— متجر سلة (قراءة فقط): رمز وصول من تطبيقك في Salla Partners
# الصلاحيات المطلوبة: orders.read, products.read (ومعلومات المتجر). رموز سلة تنتهي صلاحيتها — جدّدها عند ظهور خطأ 401.
# SALLA_ACCESS_TOKEN=

# ——— Shopify (قراءة فقط): اسم المتجر + إما رمز وصول، أو بيانات تطبيق Dev Dashboard (client credentials)
# الصلاحيات: read_orders, read_products (و read_all_orders لطلبات أقدم من 60 يومًا)
# SHOPIFY_SHOP=your-store.myshopify.com
# SHOPIFY_ACCESS_TOKEN=
# SHOPIFY_CLIENT_ID=
# SHOPIFY_CLIENT_SECRET=
# SHOPIFY_API_VERSION=2026-07

# ——— البريد (SMTP). كل رسالة تتطلب موافقتك قبل الإرسال. لـ Gmail: smtp.gmail.com:587 مع App Password
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="عبدالعزيز <you@example.com>"

# ——— إشعارات Telegram (لك فقط): نتائج المهام المجدولة، طلبات الموافقة، المواعيد الفائتة
# 1) أنشئ بوتًا عبر @BotFather  2) أرسل له أي رسالة  3) احصل على chat_id من https://api.telegram.org/bot<TOKEN>/getUpdates
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# ——— النسخ الاحتياطي: يدويًا بـ npm run backup، أو تلقائيًا بجدول cron
# BACKUP_CRON=30 3 * * *
BACKUP_KEEP=14
# BACKUP_DIR=data/backups

# تسعير مخصص فقط إن استخدمت نموذجًا غير موجود في جدول الأسعار ($ لكل مليون توكن)
# PRICE_INPUT_PER_MTOK=
# PRICE_OUTPUT_PER_MTOK=
