# ——— انسخ هذا الملف إلى .env واملأ القيم. لا ترفع .env إلى Git.

# مفتاح Claude API (مطلوب للمحادثة): https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=

# كلمة مرور الدخول للواجهة (مطلوبة). الأفضل استخدام التجزئة بدل النص الصريح:
#   npm run hash-password -- "كلمة-مرور-قوية"   ثم ضع الناتج في APP_PASSWORD_HASH واحذف APP_PASSWORD
APP_PASSWORD=
# APP_PASSWORD_HASH=

# الشبكة: 127.0.0.1 = على جهازك فقط. للإتاحة عبر الإنترنت: 0.0.0.0 خلف HTTPS مع SECURE_COOKIES=true
HOST=127.0.0.1
PORT=3000
SECURE_COOKIES=false
SESSION_TTL_HOURS=72

# النموذج والجهد
CLAUDE_MODEL=claude-opus-5
CLAUDE_EFFORT=high
CLAUDE_MAX_TOKENS=16000
# إعادة المحاولة تلقائيًا على نموذج بديل عند رفض الطلب (مفعّل افتراضيًا مع claude-opus-5)
CLAUDE_SERVER_FALLBACKS=true

# البحث عبر الإنترنت (أداة Anthropic web search). فعّلها أولًا لمؤسستك في Claude Console.
# التكلفة: 10$ لكل 1000 عملية بحث + التوكنات.
WEB_SEARCH_ENABLED=false
WEB_SEARCH_MAX_USES=5

# الحدود الافتراضية (يمكن تعديلها من صفحة الإعدادات)
MAX_STEPS_PER_RUN=12
MAX_COST_PER_RUN_USD=0.5
DAILY_COST_LIMIT_USD=5

# الملفات والجدولة
MAX_UPLOAD_MB=15
SCHEDULER_ENABLED=true
TZ_NAME=Asia/Riyadh
DATA_DIR=data

# تسعير مخصص فقط إن استخدمت نموذجًا غير موجود في جدول الأسعار ($ لكل مليون توكن)
# PRICE_INPUT_PER_MTOK=
# PRICE_OUTPUT_PER_MTOK=
